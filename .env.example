# Postgres connection string. In production use the Supabase pooler URL
# (Project Settings → Database → Connection string → Transaction pooler, port 6543).
DATABASE_URI=postgresql://user:password@127.0.0.1:5432/timesarrow

# Long random string used by Payload to sign auth tokens. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Public base URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" until BASL approves the content. "true" allows search engines to index.
SITE_INDEXABLE=false

# Supabase Storage (S3-compatible) for media uploads. Leave blank locally to store
# uploads on disk in ./media.
# Project Settings → Storage → S3 Connection.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: accounts created by `pnpm seed` for local testing.
# Creates admin@, compliance@ and editor@ on the SEED_ADMIN_EMAIL domain.
SEED_ADMIN_EMAIL=admin@timesarrow.test
SEED_PASSWORD=
