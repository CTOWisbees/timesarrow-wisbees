# Copy to .env.local for local development (local Postgres). Production (Supabase)
# values go in .env.production, or in Vercel Project Settings. .env.local always
# wins over .env.production, so local runs never touch Supabase.


# Postgres connection string. In production use the Supabase pooler URL
# (Project Settings → Database → Connection string → Transaction pooler, port 6543). Do not use the
# session pooler (5432) on Vercel: it allows only ~15 clients in total and fills up. The app adds the
# search_path option the pooler needs. One Supabase project can serve dev and production; local dev
# should still use a local Postgres so the dev schema push never touches it.
DATABASE_URI=postgresql://user:password@127.0.0.1:5432/timesarrow

# Long random string used by Payload to sign auth tokens. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Public base URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" until BASL approves the content. "true" allows search engines to index.
SITE_INDEXABLE=false

# Supabase Storage (S3-compatible) for media uploads. Leave blank locally to store
# uploads on disk in ./media.
# Project Settings → Storage → S3 Connection.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: accounts created by `pnpm seed` for local testing.
# Creates admin@, compliance@ and editor@ on the SEED_ADMIN_EMAIL domain.
SEED_ADMIN_EMAIL=
SEED_PASSWORD=

# Supabase Auth (client sign-up / login). Project Settings → API Keys.
# Use the publishable key (sb_publishable_…), never the secret key: NEXT_PUBLIC_ values reach the browser.
# The same project is used locally; local runs only use http://localhost:3000.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LOCAL DEMOS ONLY. Skips the email code so Supabase's email limit can't block a demo.
# Needs the secret key (Project Settings → API Keys → Secret keys). Server-side only:
# never prefix it with NEXT_PUBLIC_. Ignored in production builds; never set these on Vercel.
AUTH_DEV_BYPASS=false
SUPABASE_SECRET_KEY=

# Portfolio Scan payments (Razorpay). Start with test keys. Without them, paid plans can
# only be granted locally in demo mode. Webhook: POST /api/portfolio/billing/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Nightly job (/api/portfolio/cron): Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Without it the job only runs in development.
CRON_SECRET=
