    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "pdfjs-dist": "4.10.38",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
