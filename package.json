    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "8.6.0",
